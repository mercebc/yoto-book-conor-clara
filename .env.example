# ── LLM ──────────────────────────────────────────────────────────────────────
# Obtain at: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=your_key_here
LLM_MODEL=gemini-2.5-flash        # or gemini-2.0-flash-lite

# ── TTS Provider ─────────────────────────────────────────────────────────────
# Options: edge (free) | elevenlabs (best quality) | openai (good quality)
TTS_PROVIDER=edge

# Voice per language — depends on provider:
#   edge:        any Microsoft Neural voice name
#   elevenlabs:  voice_id from your ElevenLabs account
#   openai:      alloy | echo | fable | onyx | nova | shimmer
TTS_VOICE_CA=ca-ES-JoanaNeural
TTS_VOICE_EN=en-IE-ConnorNeural

# ── ElevenLabs (only if TTS_PROVIDER=elevenlabs) ──────────────────────────────
# ELEVENLABS_API_KEY=your_key_here

# ── OpenAI (only if TTS_PROVIDER=openai) ─────────────────────────────────────
# OPENAI_API_KEY=your_key_here
# TTS_OPENAI_INSTRUCTIONS= specific_open_ai_instruccions

# ── Yoto ─────────────────────────────────────────────────────────────────────
# Create a Public Client app at: https://developer.yotoplay.com
YOTO_CLIENT_ID=your_client_id_here
